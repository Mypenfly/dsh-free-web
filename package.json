{
  "name": "dsh-free-web",
  "version": "0.2.0",
  "private": true,
  "description": "Keyless providers for the built-in web_search and web_fetch tools: multi-engine search (RRF fusion, circuit breaker, decoy gate) and reader-mode fetching, registered into the ctx.web seam with no new tools and no prompt injection",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.png",
    "./client": "./src/client.js"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "locale",
    "assets",
    "README.md",
    "docs"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "probe": "node scripts/probe-live-tool.mjs",
    "measure": "node scripts/measure-wire.mjs"
  },
  "engines": {
    "node": ">=22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "configForms"
      ]
    }
  },
  "icon": "./assets/icon.png",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mypenfly/dsh-free-web.git"
  },
  "homepage": "https://github.com/Mypenfly/dsh-free-web#readme",
  "bugs": {
    "url": "https://github.com/Mypenfly/dsh-free-web/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "web-search",
    "web-fetch",
    "free",
    "keyless"
  ]
}
